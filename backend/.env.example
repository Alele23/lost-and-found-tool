# Copy this file to `.env` in the same directory and fill in real values.
# `.env` is git-ignored; this template is committed so anyone cloning the repo
# knows which variables to provide.

# Shared secret that API clients must send in the `X-API-Key` header.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=

# Google AI Studio API key -- https://aistudio.google.com/apikey
# Used by the Gemini vision calls (added in Step 5).
GEMINI_API_KEY=

# Optional: overrides the default Gemini model (see app/config.py).
# GEMINI_MODEL=gemini-3.6-flash

# Path to the Google service-account JSON file, relative to `backend/`.
# Used by the Google Sheets client (added in Step 6).
GOOGLE_CREDENTIALS_FILE=service_account.json

# ID of the target Google Sheet -- the long token between `/d/` and `/edit`
# in the sheet's URL. Used in Step 6.
SHEET_ID=
